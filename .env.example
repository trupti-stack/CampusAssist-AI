# Generate a long random value, then copy it to CAMPUSASSIST_API_KEY.
CAMPUSASSIST_API_KEY=replace-with-a-random-32-plus-character-token

# Choose gemini or openai. Only the selected provider's key is needed.
LLM_PROVIDER=gemini
GEMINI_API_KEY=add-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

APP_ENV=development
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200
MAX_QUESTION_CHARS=1500
MAX_HISTORY_MESSAGES=8
MAX_HISTORY_MESSAGE_CHARS=2000
CAMPUS_KNOWLEDGE_PATH=data/campus_knowledge.json

EXTERNAL_API_TIMEOUT_SECONDS=8
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=20000
